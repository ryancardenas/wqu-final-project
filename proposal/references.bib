
@article{figlewski_risk-neutral_2018,
	title = {Risk-{Neutral} {Densities}: {A} {Review}},
	volume = {10},
	issn = {1941-1367, 1941-1375},
	shorttitle = {Risk-{Neutral} {Densities}},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-financial-110217-022944},
	doi = {10.1146/annurev-financial-110217-022944},
	abstract = {Trading in options with a wide range of exercise prices and a single maturity allows a researcher to extract the market\&apos;s risk-neutral density (RND) over the underlying price at expiration. The RND contains investors’ beliefs about the true probabilities blended with their risk preferences, both of which are of great interest to academics and practitioners alike. With a particular focus on US equity options, I review the historical development of this powerful concept, practical details of fitting an RND to options market prices, and the many ways in which investigators have tried to distill true expectations and risk premia from observed RNDs. I briefly discuss areas of active current research including the pricing kernel puzzle and the volatility surface, and offer thoughts on what has been learned about RNDs so far and fruitful directions for future research.},
	language = {en},
	number = {Volume 10, 2018},
	urldate = {2025-10-25},
	journal = {Annual Review of Financial Economics},
	author = {Figlewski, Stephen},
	month = nov,
	year = {2018},
	note = {Publisher: Annual Reviews},
	pages = {329--359},
	file = {PDF:/Users/ryancardenas/Zotero/storage/F5JB6CYA/Figlewski - Risk-Neutral Densities A Review.pdf:application/pdf;Snapshot:/Users/ryancardenas/Zotero/storage/MKMUBQRS/annurev-financial-110217-022944.html:text/html},
}

@article{yu_risk-neutrality_2020,

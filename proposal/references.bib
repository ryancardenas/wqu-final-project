}

@misc{bloch_learning_2023,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Learning {The} {Pricing} {Kernel}: {Applications} {To} {Option} {Pricing}},
	shorttitle = {Learning {The} {Pricing} {Kernel}},
	url = {https://papers.ssrn.com/abstract=4394689},
	doi = {10.2139/ssrn.4394689},
	abstract = {We seek to estimate a portfolio of option prices in an entirely data driven way, at any future time, for trading and risk management purposes in a model independent way. We do not know the model driving the dynamics of the actual stock prices, but only observe discretely their evolution in the historical measure. We must therefore map option prices from the historical measure to the risk-neutral measure. Fortunately, we can consider the no-arbitrage condition expressed in terms of conditional expectations and use it to derive the adjusted pricing kernel (APK), which allows for the mapping of options from the historical measure to the risk-neutral measure. We relate it to the market price of risk factor (MPRF), which we express in terms of a ratio of European options in the subjective measure over the observed forward price in the risk-neutral measure. We augment market data by using Machine Learning (ML) to generate consistent synthetic data closely related to the original time series that reproduces the well known stylised facts of financial assets. Thereafter, we apply Reinforcement Learning (RL) to estimate option prices on this dataset, and use these subjective prices with the observed forward price to compute the adjusted pricing kernel. We can then modify the discretely observed stock prices with the APK to recover the risk-adjusted process on average. Afterwards, we use this risk-adjusted process in a TD-model to compute the expected value of the contingent claims in the risk-neutral measure. We can also use this synthetic to disentangle the pricing kernel from the risk-neutral probability and the historical one. Finally, we illustrate our approach in a simple model where the market price of risk is driven by an Ornstein-Uhlenbeck process.},
	language = {en},
	urldate = {2025-10-30},
	publisher = {Social Science Research Network},
	author = {Bloch, Daniel Alexandre},
	month = mar,
	year = {2023},
	keywords = {Machine Learning, Option Pricing, Pricing Kernel, Reinforcement Learning},
	file = {Full Text PDF:/Users/ryancardenas/Zotero/storage/TB6AN5DS/Bloch - 2023 - Learning The Pricing Kernel Applications To Option Pricing.pdf:application/pdf},
}

@misc{liang_nonlinear_2025,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Nonlinear {Pricing} {Kernel} via {Explainable} {Neural} {Networks}},
	url = {https://papers.ssrn.com/abstract=5608230},
	doi = {10.2139/ssrn.5608230},
	abstract = {We develop a framework for the optimal specification of a pricing kernel, also known as stochastic discount factor (SDF), by formulating a constrained optimization problem over a space of neural network functions. Departing from traditional linear kernel models, we approximate the SDF as a nonlinear function of pricing factors implemented with feedforward neural networks. The objective is to minimize a quadratic form of pricing errors, subject to a non-negativity constraint on the kernel that guarantees arbitrage-free pricing. This yields a non-convex, high-dimensional optimization problem over network weights, with the constraint incorporated via architecture and activation design. We develop a procedure through hypothesis testing to select the optimal network architecture among candidate specifications, enhancing model comparability and robustness. Empirically, we show that the worst-performing neural network outperforms the linear benchmark in pricing accuracy. Furthermore, statistical significance tests identify key pricing factors in the high-dimensional setting, improving the interpretability of the learned pricing kernel. Overall, our results demonstrate the advantages of neural networks in both flexibility and scalability for solving constrained asset pricing problems.},
	language = {en},
	urldate = {2025-10-30},
	publisher = {Social Science Research Network},
	author = {Liang, Jiawen and Chen, Cathy Yi-Hsuan and Kyriakou, Ioannis},
	month = oct,
	year = {2025},
	keywords = {Finance, neural networks, constrained optimization, ESG, model selection},
	file = {Full Text PDF:/Users/ryancardenas/Zotero/storage/73A3V9UU/Liang et al. - 2025 - Nonlinear Pricing Kernel via Explainable Neural Networks.pdf:application/pdf},
}

@article{chen_deep_2019,
	title = {Deep {Learning} in {Asset} {Pricing}},
	abstract = {We propose a novel approach to estimate asset pricing models for individual stock returns that takes advantage of the vast amount of conditioning information, while keeping a fully ﬂexible form and accounting for time-variation. Our general non-linear asset pricing model is estimated with deep neural networks applied to all U.S. equity data combined with a substantial set of macroeconomic and ﬁrm-speciﬁc information. We estimate the stochastic discount factor that explains all asset returns from the conditional moment constraints implied by no-arbitrage. Our asset pricing model outperforms out-of-sample all other benchmark approaches in terms of Sharpe ratio, explained variation and pricing errors. We trace its superior performance to including the no-arbitrage constraint in the estimation and to accounting for macroeconomic conditions and non-linear interactions between ﬁrm-speciﬁc characteristics. Our generative adversarial network enforces no-arbitrage by identifying the portfolio strategies with the most pricing information. Our recurrent Long-Short-Term-Memory network ﬁnds a small set of hidden economic state processes. A feedforward network captures the non-linear eﬀects of the conditioning variables. Our model allows us to identify the key factors that drive asset prices and generate proﬁtable investment strategies.},
	language = {en},
	author = {Chen, Luyang and Pelger, Markus and Zhu, Jason},
	year = {2019},
	file = {PDF:/Users/ryancardenas/Zotero/storage/V56DKWFE/Chen et al. - Deep Learning in Asset Pricing.pdf:application/pdf},
}

